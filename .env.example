# Credenciais da API do LinkedIn (crie um app em https://www.linkedin.com/developers/)
# Copie este arquivo para .env e preencha com seus valores. Nunca commite o .env.
LINKEDIN_CLIENT_ID=seu_client_id
LINKEDIN_CLIENT_SECRET=seu_client_secret
LINKEDIN_PERSON_ID=seu_person_id

# Opcional: fuso dos horários do frontmatter (padrão America/Sao_Paulo)
# LINKEASY_TZ=America/Sao_Paulo
